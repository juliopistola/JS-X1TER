-- ===== TELEPORTE MAIS SEGURO (V4.1) =====
-- Evita mover apenas o HumanoidRootPart (que pode desalinhar o avatar),
-- verifica piso no destino e zera velocidades. Nao contorna regras do servidor.
local function teleportarSeguro(destino, rotulo, ignorarPersonagem)
 if typeof(destino)~='CFrame' then
  notify('Destino invalido')
  return false
 end
 local char=character()
 local r=root()
 local h=humanoid()
 if not char or not r or not h or h.Health<=0 then
  notify('Aguarde seu personagem aparecer para teleportar')
  return false
 end
 local cast=RaycastParams.new()
 cast.FilterType=Enum.RaycastFilterType.Exclude
 cast.FilterDescendantsInstances=ignorarPersonagem and {char,ignorarPersonagem} or {char}
 cast.RespectCanCollide=true
 local base=destino.Position
 local hit=workspace:Raycast(base+Vector3.new(0,1.5,0),Vector3.new(0,-32,0),cast)
 if not hit or hit.Normal.Y<0.65 then
  notify('Teleporte cancelado: destino sem chao seguro')
  return false
 end
 local altura=math.max(2.5,h.HipHeight+r.Size.Y*.5+.55)
 local pos=Vector3.new(base.X,math.max(base.Y,hit.Position.Y+altura),base.Z)
 -- Procura paredes/obstaculos no espaco ocupado pelo personagem.
 local overlap=OverlapParams.new()
 overlap.FilterType=Enum.RaycastFilterType.Exclude
 overlap.FilterDescendantsInstances=cast.FilterDescendantsInstances
 overlap.MaxParts=32
 local ok,parts=pcall(function()
  return workspace:GetPartBoundsInBox(CFrame.new(pos),Vector3.new(2,math.max(2.8,r.Size.Y+1.0),2),overlap)
 end)
 if ok then
  for _,part in ipairs(parts) do
   if part.CanCollide then
    notify('Teleporte cancelado: destino ocupado por uma parede')
    return false
   end
  end
 end
 if settings.fly then
  settings.fly=false
  stopFlyPhysics()
 end
 for _,part in ipairs(char:GetDescendants()) do
  if part:IsA('BasePart') and not part.Anchored then
   part.AssemblyLinearVelocity=Vector3.zero
   part.AssemblyAngularVelocity=Vector3.zero
  end
 end
 local cf=CFrame.new(pos)*destino.Rotation
 local moved,err=pcall(function() char:PivotTo(cf) end)
 if not moved then
  warn('[JS MENU] Falha no teleporte: '..tostring(err))
  notify('Nao foi possivel teleportar')
  return false
 end
 r.AssemblyLinearVelocity=Vector3.zero
 r.AssemblyAngularVelocity=Vector3.zero
 notify(rotulo or 'Teleporte realizado')
 return true
end

