-- Atualizacao do ESP APOS a camera. Evita o atraso do desenho em movimentos
-- rapidos de mouse e separa o custo do ESP do restante da interface.
pcall(function() Run:UnbindFromRenderStep(espRenderBindingName) end)
Run:BindToRenderStep(espRenderBindingName,Enum.RenderPriority.Camera.Value+2,function(dt)
 if not alive then return end
 Camera=workspace.CurrentCamera
 if not Camera then return end
 local espEnabled=ownESPEnabled() or settings.espBox or settings.espLine or settings.espSkeleton
  or settings.espName or settings.espLife or settings.espDistance
  or settings.espHighlight
 if not espEnabled then
  if espWasEnabled then pcall(updateESP) end
  espWasEnabled=false
  espTick=0
  return
 end
 espWasEnabled=true
 espTick=espTick+dt
 -- Em PC rapido, acompanha a camera ate 60 vezes por segundo. Em PCs mais
 -- lentos, adapta a frequencia sem acumular atualizacoes atrasadas.
 local espInterval=(avgFps>=45) and (1/30) or (1/20)
 if espTick<espInterval then return end
 -- Preserva a fracao de tempo restante: zerar aqui fazia 61 FPS virar
 -- 30 atualizacoes por segundo em vez de acompanhar todos os frames.
 espTick=math.min(math.max(espTick-espInterval,0),espInterval)
 local ok,err=pcall(updateESP)
 if not ok and os.clock()-espLastErrorAt>5 then
  espLastErrorAt=os.clock()
  warn('[KIRA MENU / ESP] Erro de renderizacao: '..tostring(err))
 end
end)
listen(Run.Heartbeat,function(dt)
 if not alive then return end
 if settings.fly then
  local r=root();local h=humanoid();local cam=workspace.CurrentCamera
  if r and h and cam and h.Health>0 then
   if flyRoot~=r or not flyVelocity or not flyGyro then
    stopFlyPhysics()
    flyRoot=r
    flyOriginalPlatformStand=h.PlatformStand
    flyOriginalAutoRotate=h.AutoRotate
    flyVelocity=Instance.new('BodyVelocity')
    flyVelocity.Name='CHAT_FLY_VELOCITY'
    flyVelocity.MaxForce=Vector3.new(5e6,5e6,5e6)
    flyVelocity.P=14000
    flyVelocity.Velocity=Vector3.zero
    flyVelocity.Parent=r
    flyGyro=Instance.new('BodyGyro')
    flyGyro.Name='CHAT_FLY_GYRO'
    flyGyro.MaxTorque=Vector3.new(1e8,1e8,1e8)
    flyGyro.P=35000
    flyGyro.D=1200
    flyGyro.CFrame=cam.CFrame
    flyGyro.Parent=r
   end
   -- PlatformStand=true causa quedas/ragdoll em alguns jogos.
   -- AutoRotate fica falso apenas durante o Fly; BodyGyro cuida da direcao.
   h.PlatformStand=false
   h.AutoRotate=false
   local move=Vector3.zero
   local forward=cam.CFrame.LookVector
   local right=cam.CFrame.RightVector
   if UIS.KeyboardEnabled then
    if UIS:IsKeyDown(Enum.KeyCode.W) then move=move+forward end
    if UIS:IsKeyDown(Enum.KeyCode.S) then move=move-forward end
    if UIS:IsKeyDown(Enum.KeyCode.D) then move=move+right end
    if UIS:IsKeyDown(Enum.KeyCode.A) then move=move-right end
   end
   if move.Magnitude<.05 then
    local md=h.MoveDirection
    if md.Magnitude>.05 then move=md end
   end
   local up=(settings.flyUp and 1 or 0)-(settings.flyDown and 1 or 0)
   if UIS:IsKeyDown(Enum.KeyCode.Space) then up=up+1 end
   if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then up=up-1 end
   move=move+Vector3.new(0,up,0)
   if move.Magnitude>1 then move=move.Unit end
   local goal=move*settings.flySpeed
   -- Acima de 1000 o modo de protecao suave nao atua.
   if settings.flySpeed<=1000 then
    local speed=goal.Magnitude
    if speed>1000 then goal=goal.Unit*1000 end
   end
   local responsiveness=0.70*(1-settings.flySmooth/100)+0.025
   local frameAlpha=1-math.pow(1-responsiveness,math.clamp((dt or 1/60)*60,0,4))
   flyVelocitySmooth=flyVelocitySmooth:Lerp(goal,frameAlpha)
   flyVelocity.Velocity=flyVelocitySmooth
   flyGyro.CFrame=CFrame.lookAt(r.Position,r.Position+cam.CFrame.LookVector)
  else
   stopFlyPhysics()
  end
 elseif flyVelocity or flyGyro then
  stopFlyPhysics()
 end
end)
