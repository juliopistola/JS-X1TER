-- Noclip local: acompanha novas partes, respawn e alteracoes de colisao.
-- Jogos que validam colisao no servidor podem impedir o efeito.
-- Mantem as colisoes locais desativadas sem mudar objetos do mapa.
-- Reseta a lista a cada respawn e restaura ao desativar.
local noclipCharacter=nil
local noclipCharacterConnection=nil
settings.clearNoclip=function()
 for part,original in pairs(partCanCollide) do
  if part and part.Parent then pcall(function() part.CanCollide=original end) end
 end
 table.clear(partCanCollide)
end
local function noclipPart(part)
 if not settings.noclip or not part:IsA('BasePart') then return end
 if partCanCollide[part]==nil then partCanCollide[part]=part.CanCollide end
 if part.CanCollide then pcall(function() part.CanCollide=false end) end
end
settings.refreshNoclip=function()
 if not alive or not settings.noclip then return end
 local c=character()
 if not c then return end
 if c~=noclipCharacter then
  if noclipCharacterConnection then noclipCharacterConnection:Disconnect() end
  settings.clearNoclip()
  noclipCharacter=c
  noclipCharacterConnection=c.DescendantAdded:Connect(function(part)
   if alive and settings.noclip then noclipPart(part) end
  end)
  table.insert(conn,noclipCharacterConnection)
 end
 for _,part in ipairs(c:GetDescendants()) do noclipPart(part) end
end
