  for i=1,4 do
   if not e.box[i] then e.box[i]=espTriple(e.frame) end
   espDrawTriple(e.box[i],corners[i][1],corners[i][2],ownESP.thickness,color)
   e.box[i].core.BackgroundTransparency=alpha
  end
 end
 if ownESP.highlight then
  if not e.highlight or not e.highlight.Parent then
   local hl=Instance.new('Highlight')
   hl.Name='KIRA_ESP_MY_Highlight'
   hl.Adornee=char
   hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
   hl.Parent=char
   e.highlight=hl
  end
  e.highlight.FillColor=color
  e.highlight.OutlineColor=color
  e.highlight.FillTransparency=.75
  e.highlight.OutlineTransparency=alpha
  e.highlight.Enabled=true
 end
 if ownESP.name then
  e.name.Visible=true;e.name.Text=plr.DisplayName
  e.name.TextColor3=color;e.name.TextSize=ownESP.textSize
  e.name.Size=UDim2.fromOffset(math.max(70,math.min(185,right-left+40)),18)
  e.name.Position=UDim2.fromOffset(midX-e.name.Size.X.Offset*.5,top-20)
 end
 if ownESP.distance then
  local cam=workspace.CurrentCamera
  local meters=cam and (cam.CFrame.Position-r.Position).Magnitude*.28 or 0
  e.range.Visible=true;e.range.Text=tostring(math.floor(meters+.5))..'m'
  e.range.TextColor3=color;e.range.TextSize=ownESP.textSize
  e.range.Position=UDim2.fromOffset(midX-45,bottom+2)
  e.range.Size=UDim2.fromOffset(90,16)
 end
 if ownESP.life then
  local hp=math.clamp(h.Health/math.max(h.MaxHealth,1),0,1)
  local barW=math.clamp(height/42,2,4)
  local barH=math.max(8,height-2)
  local gap=math.clamp(height/100,2,3)
  local bx=left-gap-barW
  e.hpShadow.Visible=true
  e.hpShadow.BackgroundColor3=Color3.fromRGB(12,42,22)
  e.hpShadow.Position=UDim2.fromOffset(bx,top+(height-barH)*.5)
  e.hpShadow.Size=UDim2.fromOffset(barW,barH)
  e.hpFill.BackgroundColor3=C_VIDA
  e.hpFill.Size=UDim2.fromScale(1,hp)
  if height>=65 then
   e.hpText.Visible=true
   e.hpText.Text=tostring(math.floor(h.Health+.5))
   e.hpText.TextColor3=C_VIDA
   e.hpText.Position=UDim2.fromOffset(bx-15,top-15)
   e.hpText.Size=UDim2.fromOffset(35,14)
  end
 end
 if ownESP.skeleton and height>=18 then
  local joints,segments=espJoints(char)
  local projected={}
  for key,w in pairs(joints) do
   local vec,z=espProjected(w)
   if vec and z>.1 then projected[key]=vec end
  end
  for i,pair in ipairs(segments) do
   local a,b=projected[pair[1]],projected[pair[2]]
   if a and b and (b-a).Magnitude<=math.max(35,height*1.15) then
    if not e.bones[i] then e.bones[i]=espTriple(e.frame) end
    espDrawTriple(e.bones[i],a,b,ownESP.thickness,color)
