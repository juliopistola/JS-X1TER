 return UDim2.new(menuHomePosition.X.Scale,menuHomePosition.X.Offset,1.4,0)
end
local function setMenuOpen(v)
 if menuAnimating or not alive or menuOpen==v then return end
 menuAnimating=true
 tapSound()
 local target=math.min(tonumber(openScale:GetAttribute('EscalaEscolhida')) or 1,fitScaleForDevice())
 if v then
  menu.AnchorPoint=menuHomeAnchor
  menu.Position=menuBelowScreen()
  openScale.Scale=target*.78
  menu.Visible=true
  if uiMotion then
   local move=tween(menu,.85,{Position=menuHomePosition})
   tween(openScale,.85,{Scale=target})
   move.Completed:Wait()
  else
   menu.Position=menuHomePosition
   openScale.Scale=target
  end
  if alive then
   menuOpen=true
   if not settings.tabState.ready then settings.tabState.enable()
   else settings.tabState.restoreScroll(settings.tabState.current) end
  end
 else
  if uiMotion then
   local move=tween(menu,.85,{Position=menuBelowScreen()})
   tween(openScale,.85,{Scale=target*.78})
   move.Completed:Wait()
  end
  if alive then
   menu.Visible=false
   menu.Position=menuHomePosition
   openScale.Scale=target
   menuOpen=false
  end
 end
 menuAnimating=false
 updateKeyPanel()
end
