local speedLastHumanoid=nil
local speedApplied=16
local function applyMovement()
 local h=humanoid()
 if h then
  local wanted=settings.speed and settings.speedValue or 16
  if h~=speedLastHumanoid then
   speedLastHumanoid=h
   speedApplied=h.WalkSpeed
  end
  if not settings.speed then
   speedApplied=16
   h.WalkSpeed=16
  elseif math.abs((h.WalkSpeed or 16)-speedApplied)>3 then
   speedApplied=h.WalkSpeed
  end
  h.UseJumpPower=true
  h.JumpPower=settings.jump and settings.jumpValue or 50
 end
 workspace.Gravity=settings.customGravity and settings.gravity or originals.gravity
end
-- O limite de 1000 aqui se refere ao controle local do painel.
-- Servidores podem detectar e causar dano em qualquer velocidade.
local movementGroundRay=RaycastParams.new()
movementGroundRay.FilterType=Enum.RaycastFilterType.Exclude
movementGroundRay.IgnoreWater=true
local speedTicker=0
listen(Run.Heartbeat,function(dt)
 if not alive then return end
 local h=humanoid()
 if not h or h.Health<=0 then return end
 if settings.speed then
  if h~=speedLastHumanoid then
   speedLastHumanoid=h
   speedApplied=h.WalkSpeed
  end
  -- Suavizar aumento/reducao para reduzir impulsos subitos.
  local wanted=math.clamp(settings.speedValue,0,1200)
  local step=1700*math.clamp(dt,0,.12)
  speedApplied=speedApplied+math.clamp(wanted-speedApplied,-step,step)
  if math.abs(h.WalkSpeed-speedApplied)>.05 then h.WalkSpeed=speedApplied end
 end
 -- Ao caminhar rapidamente, tentar reduzir impacto de queda proxima ao solo.
 -- Isto nao bloqueia dano ou anticheat aplicados pelo servidor.
 speedTicker=speedTicker+dt
 if speedTicker<.09 then return end
 speedTicker=0
 if (not settings.fly) and settings.speed and settings.speedValue<=1000 then
  local r=root()
  if r and r:IsA('BasePart') then
   local v=r.AssemblyLinearVelocity
   if v.Y< -52 then
    movementGroundRay.FilterDescendantsInstances={character()}
    local floor=workspace:Raycast(r.Position,Vector3.new(0,-14,0),movementGroundRay)
    if floor and floor.Instance and floor.Instance.CanCollide then
     r.AssemblyLinearVelocity=Vector3.new(v.X,-32,v.Z)
    end
   end
  end
 end
end)
