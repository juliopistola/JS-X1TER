-- Tamanho, volume e tecla de abrir/fechar sao persistentes por UserId.
-- Posicao e estados de toggles continuam com valores padrao.
local function restorePanelLayout()
 if type(readfile)~='function' then return end
 local ok,data=pcall(function() return HttpService:JSONDecode(readfile(layoutFile)) end)
 if not ok or type(data)~='table' then return end
 if type(data.scale)=='number' then
  local v=math.clamp(data.scale,.65,1.15)
  openScale:SetAttribute('EscalaEscolhida',v)
  openScale.Scale=math.min(v,fitScaleForDevice())
 end
end
savePanelLayout=function()
 if type(writefile)~='function' then return end
 local payload={scale=tonumber(openScale:GetAttribute('EscalaEscolhida')) or openScale.Scale}
 pcall(function() writefile(layoutFile,HttpService:JSONEncode(payload)) end)
end
