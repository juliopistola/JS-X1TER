local hitboxOriginal={}
-- Um adorno 3D independente da textura do personagem: a cor e a opacidade
-- continuam visiveis mesmo quando uma roupa/mesh ignora a cor da BasePart.
local hitboxVisual={}
local headVisualOriginal={}
local function restoreHeadVisual(part)
 local saved=headVisualOriginal[part]
 if not saved then return end
 pcall(function()
  if part and part.Parent then
   part.Material=saved.Material
   part.Reflectance=saved.Reflectance
   if part:IsA('MeshPart') then part.TextureID=saved.TextureID end
  end
  for child,properties in pairs(saved.Children) do
   if child and child.Parent then
    if properties.Transparency~=nil then child.Transparency=properties.Transparency end
    if properties.TextureId~=nil then child.TextureId=properties.TextureId end
   end
  end
 end)
 headVisualOriginal[part]=nil
end
local function blackenHeadVisual(part)
 if not headVisualOriginal[part] then
  local saved={Material=part.Material,Reflectance=part.Reflectance,Children={}}
  if part:IsA('MeshPart') then saved.TextureID=part.TextureID end
  headVisualOriginal[part]=saved
 end
 local saved=headVisualOriginal[part]
 pcall(function()
  part.Material=Enum.Material.SmoothPlastic
  part.Reflectance=0
  if part:IsA('MeshPart') then part.TextureID='' end
  for _,child in ipairs(part:GetDescendants()) do
   if child:IsA('Decal') or child:IsA('Texture') then
    if not saved.Children[child] then saved.Children[child]={Transparency=child.Transparency} end
    child.Transparency=1
   elseif child:IsA('SpecialMesh') then
    if not saved.Children[child] then saved.Children[child]={TextureId=child.TextureId} end
    child.TextureId=''
   end
  end
 end)
end
local function restoreOneHitbox(part,old)
 local visual=hitboxVisual[part]
 if visual then visual:Destroy();hitboxVisual[part]=nil end
 restoreHeadVisual(part)
 if part and part.Parent then
  pcall(function()
   part.Size=old.Size
   if old.MeshScales then
    for mesh,scale in pairs(old.MeshScales) do
     if mesh and mesh.Parent then mesh.Scale=scale end
    end
   end
   part.Transparency=old.Transparency
   part.LocalTransparencyModifier=old.LocalTransparencyModifier
   part.CanCollide=old.CanCollide
   part.CanTouch=old.CanTouch
   part.CanQuery=old.CanQuery
   part.Massless=old.Massless
   part.Color=old.Color
  end)
 end
 hitboxOriginal[part]=nil
 settings.espNaturalSizes[part]=nil
end
local function restoreHitboxes()
 for part,old in pairs(hitboxOriginal) do restoreOneHitbox(part,old) end
end
local function setHitboxPart(part,size,isHead)
 if not part or not part:IsA('BasePart') then return false end
 if not hitboxOriginal[part] then
  hitboxOriginal[part]={Size=part.Size,Transparency=part.Transparency,
   LocalTransparencyModifier=part.LocalTransparencyModifier,
   CanCollide=part.CanCollide,CanTouch=part.CanTouch,
   CanQuery=part.CanQuery,Massless=part.Massless,Color=part.Color,MeshScales={}}
  if isHead then
   for _,mesh in ipairs(part:GetChildren()) do
    if mesh:IsA('SpecialMesh') and (mesh.MeshType==Enum.MeshType.Head
      or mesh.MeshType==Enum.MeshType.FileMesh) then
     hitboxOriginal[part].MeshScales[mesh]=mesh.Scale
    end
   end
  end
 end
 local original=hitboxOriginal[part]
 settings.espNaturalSizes[part]=original.Size
 -- Cresce mantendo a proporcao da cabeca original (R6 ou R15).
 -- Nao substitui a cabeca por cubo nem cria esfera artificial.
 local factor=isHead and (size/math.max(original.Size.X,original.Size.Y,original.Size.Z)) or 1
 local target=isHead and (original.Size*factor)
  or Vector3.new(size,size,math.max(2,size*.7))
 local ok=pcall(function()
  if part.Size~=target then part.Size=target end
  if isHead then
   for mesh,originalScale in pairs(original.MeshScales) do
    if mesh and mesh.Parent then
     local scaled=originalScale*factor
     if mesh.Scale~=scaled then mesh.Scale=scaled end
    end
   end
  end
  if part.CanCollide then part.CanCollide=false end
  -- Nao desliga CanTouch: alguns jogos usam eventos Touched para golpes.
  if part.CanTouch~=hitboxOriginal[part].CanTouch then part.CanTouch=hitboxOriginal[part].CanTouch end
  if not part.CanQuery then part.CanQuery=true end
  if not part.Massless then part.Massless=true end
  -- A cabeca mostra sua propria silhueta, sem bola ou caixa falsa.
  -- O corpo continua usando um adorno retangular.
  local opacity=math.clamp(settings.hitboxTransparency/100,0,1)
  -- Sem isso a barra alterava apenas o adorno, mas a cabeca/corpo
  -- aumentado continuava opaco; por isso parecia que nao funcionava.
  -- Nao depende da camera ou de raycast: a marcacao nao pisca quando
  -- o alvo passa atras de uma parede.
  part.LocalTransparencyModifier=math.max(original.LocalTransparencyModifier or 0,opacity)
  local visual=hitboxVisual[part]
  if not visual or not visual.Parent then
   visual=Instance.new(isHead and 'Highlight' or 'BoxHandleAdornment')
   visual.Name='VELOSO_Hitbox_Visual'
   visual.Adornee=part
   if isHead then
    visual.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    visual.OutlineTransparency=1
   else
    visual.AlwaysOnTop=true
    visual.ZIndex=2
   end
   visual.Parent=gui
   hitboxVisual[part]=visual
  end
  if isHead then
   visual.Enabled=settings.hitboxShow and opacity<1
   visual.FillColor=settings.hitboxColor
   visual.FillTransparency=opacity
  else
   visual.Size=target
   visual.Visible=settings.hitboxShow and opacity<1
   visual.Color3=settings.hitboxColor
   visual.Transparency=opacity
  end
 end)
 return ok
end
-- Atualiza a transparencia na hora, sem varrer todos os jogadores nem fazer
-- raycasts enquanto o usuario arrasta o slider. Funciona de 0 a 100%.
local function updateHitboxOpacity()
 local opacity=math.clamp(settings.hitboxTransparency/100,0,1)
 for part,visual in pairs(hitboxVisual) do
  local original=hitboxOriginal[part]
  if original and part and part.Parent then
   pcall(function()
    part.LocalTransparencyModifier=math.max(original.LocalTransparencyModifier or 0,opacity)
   end)
  end
  if visual and visual.Parent then
   if visual:IsA('Highlight') then
    visual.FillTransparency=opacity
    visual.Enabled=settings.hitboxShow and opacity<1
   else
    visual.Transparency=opacity
    visual.Visible=settings.hitboxShow and opacity<1
   end
  end
 end
end
-- HITBOX V13: reconhece o jogador caido, mesmo quando o jogo nao zera a vida.
-- Usa o estado fisico do Humanoid, orientacao do torax e proximidade com o chao.
-- Evita confundir pulo, inclinacao rapida ou personagem sentado com nocaute.
local function flagCaido(c,hum)
 for _,name in ipairs({'Ragdolled','IsRagdolled','Ragdoll','Knocked','KnockedOut','Downed','IsDowned','IsKnocked','Unconscious'}) do
  local attribute=c:GetAttribute(name)
  if attribute==true then return true end
  local value=c:FindFirstChild(name) or hum:FindFirstChild(name)
  if value and value:IsA('BoolValue') and value.Value then return true end
 end
 return false
end
local function isCharacterDownForHitbox(c,hum,rootPart)
 local state=hum:GetState()
 if state==Enum.HumanoidStateType.Dead
  or state==Enum.HumanoidStateType.Ragdoll
  or state==Enum.HumanoidStateType.FallingDown then
  return true
 end
 if flagCaido(c,hum) then return true end
 -- Nao usa inclinacao do torso como prova de queda: animacoes, veiculos e
 -- troca de rodada podem inclinar o rig por um instante e esconder a hitbox.
 return false
end
local function isAliveForHitbox(c)
 if not c or not c.Parent then return false end
 local hum=c:FindFirstChildOfClass('Humanoid')
 local rootPart=c:FindFirstChild('HumanoidRootPart')
 if not hum or not rootPart or not rootPart:IsA('BasePart') then return false end
 if hum.Health<=0 then return false end
 if isCharacterDownForHitbox(c,hum,rootPart) then return false end
 return true,rootPart
end
local function restoreCharacterHitbox(c)
 if not c then return end
 for part,old in pairs(hitboxOriginal) do
  if part and part:IsDescendantOf(c) then
   restoreOneHitbox(part,old)
  end
 end
end
local hitboxDiagnosticLabel=nil
local function isHitboxTeammate(other)
 if other==LocalPlayer then return true end
 -- Prioridade para o sistema oficial de Teams do Roblox.
 local myTeam=LocalPlayer.Team
 local otherTeam=other.Team
 if myTeam and otherTeam then return myTeam==otherTeam end
 -- Alguns jogos utilizam apenas TeamColor, sem um objeto Team associado.
 if not LocalPlayer.Neutral and not other.Neutral then
  return LocalPlayer.TeamColor==other.TeamColor
 end
 return false
end
-- O visual da hitbox nao faz raycasts de parede: evita piscar quando o alvo
-- passa de um lado para o outro de uma cobertura.
local function updateHitboxes()
 if not alive then return end
 if not settings.hitboxHead and not settings.hitboxBody then
  if next(hitboxOriginal) then restoreHitboxes() end
  if hitboxDiagnosticLabel and hitboxDiagnosticLabel.Text~='Hitbox desligada. Nenhuma parte local modificada.' then
   hitboxDiagnosticLabel.Text='Hitbox desligada. Nenhuma parte local modificada.'
  end
  return
 end
 local ownRoot=root()
 local active={}
 local adjusted=0
 for _,player in ipairs(Players:GetPlayers()) do
  if player~=LocalPlayer then
   local c=player.Character
   local living,rp=isAliveForHitbox(c)
   local sameTeam=isHitboxTeammate(player)
   local inRange=rp and ((not ownRoot) or
    ((ownRoot.Position-rp.Position).Magnitude<=settings.hitboxMaxDistance))
   local inFov=true
   if settings.hitboxUseFov then
    local cam=workspace.CurrentCamera
    if not cam or not rp then
     inFov=false
    else
     local pos,onScreen=cam:WorldToViewportPoint(rp.Position)
     local mid=cam.ViewportSize*.5
     inFov=onScreen and (Vector2.new(pos.X,pos.Y)-mid).Magnitude<=settings.hitboxFovRadius
    end
   end
   -- A hitbox NUNCA altera colegas de equipe, mesmo se outras opcoes mudarem.
   local exposed=living and inRange and inFov and not sameTeam
   if exposed then
    if settings.hitboxHead then
     local head=c:FindFirstChild('Head')
     if head and head:IsA('BasePart') then
      if setHitboxPart(head,settings.hitboxHeadSize,true) then
       active[head]=true;adjusted=adjusted+1
      end
     end
    end
    if settings.hitboxBody then
     -- O tronco visivel deve ter prioridade; HumanoidRootPart e invisivel.
     local body=c:FindFirstChild('UpperTorso') or c:FindFirstChild('Torso')
      or c:FindFirstChild('LowerTorso') or rp
     if body and body:IsA('BasePart') then
      if setHitboxPart(body,settings.hitboxBodySize,false) then
       active[body]=true;adjusted=adjusted+1
      end
     end
    end
   end
  end
 end
 -- Remover imediatamente efeitos em mortos, alvos fora do alcance e rigs antigos.
 for part,old in pairs(hitboxOriginal) do
  if not active[part] then restoreOneHitbox(part,old) end
 end
 if hitboxDiagnosticLabel then
  local status='Partes ampliadas: '..adjusted..' | Visual sem filtro de parede. Acertos dependem do servidor.'
  if hitboxDiagnosticLabel.Text~=status then hitboxDiagnosticLabel.Text=status end
 end
end
