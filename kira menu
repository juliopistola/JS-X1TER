do
 local pref=settings.pref
 local file='KIRA_PREFS_'..tostring(LocalPlayer.UserId)..'.json'
 local globalKey='KIRA_PREFS_'..tostring(LocalPlayer.UserId)
 local saved,current,handlers,order,counters={},{},{},{},{}
 local ready,saveQueued=false,false
 local globals=_G
 pcall(function() if type(getgenv)=='function' then globals=getgenv() end end)
 if type(globals)=='table' and type(globals[globalKey])=='table' then saved=globals[globalKey] end
 if type(readfile)=='function' then
  local ok,decoded=pcall(function() return HttpService:JSONDecode(readfile(file)) end)
  if ok and type(decoded)=='table' and type(decoded.controls)=='table' then
   saved=decoded.controls
  end
 end
 function pref.start(page,name,initial)
  local base=tostring(page.Name)..'|'..tostring(name)
  counters[base]=(counters[base] or 0)+1
  local key=base..'#'..counters[base]
  local value=saved[key]
  if type(value)~=type(initial) then value=initial end
  current[key]=value
  return key,value
 end
 function pref.save()
  local snapshot={}
  for key,value in pairs(current) do
   if type(value)=='boolean' or type(value)=='number' or type(value)=='string' then snapshot[key]=value end
  end
  local env=_G
  pcall(function() if type(getgenv)=='function' then env=getgenv() end end)
  if type(env)=='table' then env[globalKey]=snapshot end
  if type(writefile)=='function' then
   pcall(function() writefile(file,HttpService:JSONEncode({version=1,userId=LocalPlayer.UserId,controls=snapshot})) end)
  end
 end
 function pref.set(key,value)
  current[key]=value
  if not ready or saveQueued then return end
  -- Um unico agendamento por lote, mesmo arrastando o slider centenas de vezes.
  saveQueued=true
  task.delay(.8,function()
   saveQueued=false
   if ready then pref.save() end
  end)
 end
 function pref.register(key,fn)
  handlers[key]=fn
  table.insert(order,key)
 end
 function pref.restore()
  for _,key in ipairs(order) do
   if saved[key]~=nil and handlers[key] then pcall(handlers[key]) end
  end
  ready=true
  pref.save()
 end
 function pref.freezeAndSave()
  if ready then pref.save() end
  ready=false
  saveQueued=false
 end
end
