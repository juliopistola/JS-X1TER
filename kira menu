-- FLING DE CONTATO: gira apenas o proprio personagem; nao altera outros jogadores diretamente.
-- O servidor pode cancelar o movimento, e nao existe garantia de afetar outros avatares.
local flingAngular,flingHeight,flingRoot
local flingSavedPlatformStand=nil
local flingGroundY=nil
local flingGroundClock=0
local function stopFling()
 if flingAngular then pcall(function() flingAngular:Destroy() end) end
 if flingHeight then pcall(function() flingHeight:Destroy() end) end
 flingAngular=nil;flingHeight=nil
 if flingRoot and flingRoot.Parent then
  pcall(function() flingRoot.AssemblyAngularVelocity=Vector3.zero end)
 end
 local h=humanoid()
 if h and flingSavedPlatformStand~=nil then h.PlatformStand=flingSavedPlatformStand end
 flingSavedPlatformStand=nil;flingRoot=nil;flingGroundY=nil
end
-- SPIN VISUAL: rotacao controlada sem travar a caminhada.
-- Efeito no proprio avatar; nao controla outros jogadores.
local spinSavedAutoRotate=nil
local spinAngle=0
local spinSavedRotation=nil
local spinRoot=nil
local function stopSpin()
 local h=humanoid()
 local r=spinRoot
 if r and r.Parent and r==root() and h and h.Health>0 then
  -- Ao parar, devolver a direcao de caminhada: nao deixar o avatar de costas.
  local move=h.MoveDirection
  local horizontal=Vector3.new(move.X,0,move.Z)
  if horizontal.Magnitude>.05 then
   r.CFrame=CFrame.lookAt(r.Position,r.Position+horizontal.Unit)
  elseif spinSavedRotation then
   r.CFrame=CFrame.new(r.Position)*spinSavedRotation
  end
  r.AssemblyAngularVelocity=Vector3.zero
 end
 if h and spinSavedAutoRotate~=nil then
  h.AutoRotate=spinSavedAutoRotate
  if h.Health>0 and not h.Sit and not settings.fly
   and h.FloorMaterial~=Enum.Material.Air then
   -- Forcar o Humanoid a retomar o estado locomotor normal apos o giro.
   pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
  end
 end
 spinSavedAutoRotate=nil
 spinSavedRotation=nil
 spinRoot=nil
 spinAngle=0
end
