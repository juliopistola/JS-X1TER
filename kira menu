 end
 local cam=workspace.CurrentCamera
 if cam and (cam.CFrame.Position-r.Position).Magnitude*.28>ownESP.maxDistance then
  espHideParts(e);e.frame.Visible=false;return
 end
 local left,top,right,bottom=espBounds(char)
 if not left then espHideParts(e);e.frame.Visible=false;return end
 local height=bottom-top
 local midX=(left+right)*.5
 local color=ownESP.rgb and Color3.fromHSV((os.clock()*ownESP.rgbSpeed/180)%1,1,1) or C_AZUL
 local alpha=1-ownESP.brightness/100
 e.frame.Visible=true
 -- Limpa elementos desligados; nao cria linhas nem marca jogadores ficticios.
 espHideParts(e)
 if ownESP.box then
  local corners={
   {Vector2.new(left,top),Vector2.new(right,top)},
   {Vector2.new(right,top),Vector2.new(right,bottom)},
   {Vector2.new(right,bottom),Vector2.new(left,bottom)},
   {Vector2.new(left,bottom),Vector2.new(left,top)}
