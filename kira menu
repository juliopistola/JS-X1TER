local function center(frame,w,h)
 local cam=workspace.CurrentCamera
 local vp=(cam and cam.ViewportSize) or Vector2.new(850,650)
 frame.AnchorPoint=Vector2.new(.5,.5)
 frame.Position=UDim2.fromScale(.5,.5)
