  local equipped=0
  local function scan(container,isEquipped)
   if not container then return end
   for _,item in ipairs(container:GetChildren()) do
    if item:IsA('Tool') then
     total=total+1
     if isEquipped then equipped=equipped+1 end
     local name=tostring(item.Name):sub(1,48)
     counts[name]=(counts[name] or 0)+1
    end
   end
  end
  scan(LocalPlayer:FindFirstChildOfClass('Backpack'),false)
  scan(LocalPlayer.Character,true)
  local names={}
  for name in pairs(counts) do table.insert(names,name) end
  table.sort(names)
  local lines={('Ferramentas: %d  |  Equipadas: %d'):format(total,equipped)}
  for i=1,math.min(8,#names) do
   local name=names[i]
   table.insert(lines,name..(counts[name]>1 and ('  x'..counts[name]) or ''))
  end
  if #names>8 then table.insert(lines,'... e mais '..(#names-8)..' tipos') end
  inventorySummary.Text=table.concat(lines,'\n')
  remember('Inventario local atualizado: '..total..' ferramentas')
 end)
