 end
 local function scanTargets()
  local cam=workspace.CurrentCamera
  if not cam then return nil,0 end
  local vp=cam.ViewportSize
  local center=Vector2.new(vp.X*.5,vp.Y*.5)
  local limit=math.min(settings.combatRadius,math.min(vp.X,vp.Y)*.38)
  local nearest,nearestDist=nil,limit
  local total=0
  for _,plr in ipairs(Players:GetPlayers()) do
   if plr~=LocalPlayer and (not settings.espOnlyEnemies or not isAllyESP(plr)) then
    local char=plr.Character
    local hum=char and char:FindFirstChildOfClass('Humanoid')
    local head=char and char:FindFirstChild('Head')
    if hum and head and head:IsA('BasePart') and isStanding(char,hum) then
     local pos,onScreen=cam:WorldToViewportPoint(head.Position)
     if onScreen and pos.Z>0 then
      local dist=(Vector2.new(pos.X,pos.Y)-center).Magnitude
      if dist<=limit then
       total=total+1
       if dist<nearestDist then nearest=head;nearestDist=dist end
      end
     end
    end
   end
  end
  return nearest,total
 end
