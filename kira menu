do -- CONFIGURACOES | TELA PARADA (pose travada do Free Fire); escopo para compilacao
-- Efeito de animacao LOCAL: o boneco continua podendo andar, mas a pose
-- fica congelada na sua tela. Nao afeta dano, hitbox, tiros ou servidor.
local telaParadaAtiva=false
local telaParadaAnterior=setmetatable({},{__mode='k'})
local telaParadaTempo=0
local function restaurarTelaParada()
 telaParadaAtiva=false
 for track,velocidade in pairs(telaParadaAnterior) do
  pcall(function() track:AdjustSpeed(velocidade) end)
  telaParadaAnterior[track]=nil
 end
end
local function atualizarTelaParada()
 if not alive or not telaParadaAtiva then return end
 local char=LocalPlayer.Character
 local hum=char and char:FindFirstChildOfClass('Humanoid')
 local animator=hum and hum:FindFirstChildOfClass('Animator')
 if not animator then return end
 local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
 if not ok or not tracks then return end
 for _,track in ipairs(tracks) do
  if telaParadaAnterior[track]==nil then
   local got,speed=pcall(function() return track.Speed end)
   telaParadaAnterior[track]=got and speed or 1
  end
  pcall(function() track:AdjustSpeed(0) end)
 end
end
settings.restoreTelaParada=restaurarTelaParada
section(pages.Config,'TELA PARADA')
toggle(pages.Config,'Tela parada',false,function(ativado)
 if ativado then
  telaParadaAtiva=true
  atualizarTelaParada()
  notify('Tela parada ativada: pose congelada localmente')
 else
  restaurarTelaParada()
  notify('Tela parada desativada')
 end
end)
note(pages.Config,'Trava visualmente a pose do seu personagem enquanto voce anda. Nao congela a partida nem os outros jogadores.')
listen(Run.Heartbeat,function(dt)
 if not telaParadaAtiva or not alive then return end
 telaParadaTempo=telaParadaTempo+dt
 if telaParadaTempo>=.1 then
  telaParadaTempo=0
  atualizarTelaParada()
 end
end)

