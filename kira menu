    local haystack={}
    if item:IsA('TextButton') or item:IsA('TextLabel') then
     table.insert(haystack,item.Text)
    end
    for _,d in ipairs(item:GetDescendants()) do
     if d:IsA('TextLabel') or d:IsA('TextButton') then
      table.insert(haystack,d.Text)
     end
    end
    local joined=string.lower(table.concat(haystack,' '))
    item.Visible=(item:GetAttribute('KiraHidden')~=true) and (term=='' or string.find(joined,term,1,true)~=nil)
   end
  end
 end
