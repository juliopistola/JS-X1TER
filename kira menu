settings.tabState={}
do
 local state=settings.tabState
 local tabKey,storedTab=settings.pref.start(content,'Ultima aba aberta','Principais')
 state.initial='Principais'
 state.tabs={}
 state.ready=false
 for _,name in ipairs(tabNames) do
  if name==storedTab then state.initial=name end
  local pg=pages[name]
  local scrollKey,storedY=settings.pref.start(pg,'Rolagem vertical',0)
  state.tabs[name]={key=scrollKey,y=math.max(0,storedY),restoring=false}
  listen(pg:GetPropertyChangedSignal('CanvasPosition'),function()
   local entry=state.tabs[name]
   if not state.ready or state.current~=name or not pg.Visible or not menu.Visible or entry.restoring then return end
   local y=math.max(0,pg.CanvasPosition.Y)
   if math.abs(y-entry.y)>.5 then
    entry.y=y
    settings.pref.set(entry.key,y)
   end
  end)
 end
 function state.capture()
  local name=state.current
  local pg=name and pages[name]
  local entry=name and state.tabs[name]
  if not state.ready or not pg or not entry or entry.restoring or not pg.Visible then return end
  local y=math.max(0,pg.CanvasPosition.Y)
  entry.y=y
  settings.pref.set(entry.key,y)
 end
 function state.activate(name)
  if not state.tabs[name] then return false end
  if state.current==name then return false end
  state.capture()
  state.current=name
  settings.pref.set(tabKey,name)
  return true
 end
 function state.restoreScroll(name)
  local pg=name and pages[name]
  local entry=name and state.tabs[name]
  if not state.ready or not pg or not entry or entry.restoring then return end
  entry.restoring=true
  task.defer(function()
   if alive and pg.Parent and pg.Visible and state.current==name then
    local maxY=math.max(0,pg.AbsoluteCanvasSize.Y-pg.AbsoluteWindowSize.Y)
    pg.CanvasPosition=Vector2.new(0,math.clamp(entry.y,0,maxY))
   end
   entry.restoring=false
  end)
 end
 function state.enable()
  state.ready=true
  state.restoreScroll(state.current)
 end
end
