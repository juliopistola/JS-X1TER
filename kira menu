function updateESP()
 Camera=workspace.CurrentCamera
 if not Camera or not overlay.Parent then return end
 overlay.Visible=anyESP()
 if not overlay.Visible then
  for _,e in pairs(espEntries) do
   e.frame.Visible=false
   if e.highlight then e.highlight.Enabled=false end
  end
  return
 end
 local vp=Camera.ViewportSize
 local source=Vector2.new(vp.X*.5,vp.Y*.5)
 if settings.espLineSource=='Topo' then source=Vector2.new(vp.X*.5,0) end
 if settings.espLineSource=='Baixo' then source=Vector2.new(vp.X*.5,vp.Y) end
 local cyan=settings.espRGB and Color3.fromHSV((os.clock()*.14)%1,1,1) or C_AZUL
 local ownRoot=root()
 local needsVisibility=settings.espLine or settings.espSkeleton or settings.espHighlight
  or settings.espName or settings.espDistance or settings.espLife
 local remainingRaycastTargets=MAX_ESP_RAYCAST_TARGETS_PER_FRAME
 local activeFlags=(settings.espBox and 1 or 0)+(settings.espLine and 2 or 0)
  +(settings.espSkeleton and 4 or 0)+(settings.espName and 8 or 0)
  +(settings.espLife and 16 or 0)+(settings.espDistance and 32 or 0)
  +(settings.espHighlight and 64 or 0)
 local now=os.clock()
 local playerESPActive=settings.espBox or settings.espLine or settings.espSkeleton or settings.espName or settings.espLife or settings.espDistance or settings.espHighlight
 if playerESPActive then
 for _,plr in ipairs(espPlayers) do
  if plr~=LocalPlayer then
   local e=espEntries[plr]
   local character=plr.Character
   if e and not e.frame.Parent then
    if e.highlight then e.highlight:Destroy() end
    espEntries[plr]=nil
    e=nil
   end
   if e and e.character~=character then
    espHideParts(e)
    if e.highlight then e.highlight:Destroy();e.highlight=nil end
    e.character=character
    e.visibilityAt=nil
    e.visibilityResult=false
   end
   local humanoid=character and character:FindFirstChildOfClass('Humanoid')
   local targetRoot=character and character:FindFirstChild('HumanoidRootPart')
   -- Distancias internas de Roblox estao em studs; 1 stud ~= 0.28 metro.
   local distance=(ownRoot and targetRoot) and (ownRoot.Position-targetRoot.Position).Magnitude or math.huge
   local distanceMeters=distance*0.28
   local center,depth,inView
   if targetRoot then center,depth,inView=espProjected(targetRoot.Position) end
   -- O ESP so aparece dentro do alcance escolhido (0 a 5000 metros).
   -- 'inView' e profundidade positiva evitam desenhar atras da camera.
   local enabled=targetRoot and humanoid and inView and depth>0
       and distanceMeters<=settings.espMax
       and (not settings.espOnlyAlive or humanoid.Health>0)
       and (not settings.espOnlyEnemies or not isAllyESP(plr))
       and (not settings.espIgnoreAllies or not isAllyESP(plr))
   if enabled and not e then e=espEntry(plr);e.character=character end
   if e then
    e.frame.Visible=not not enabled
    if not enabled and e.highlight then e.highlight.Enabled=false end
   end
   if enabled and e then
    local left,top,right,bottom=espBounds(character)
    if not left then
     e.frame.Visible=false
     if e.highlight then e.highlight.Enabled=false end
    else
     -- Ocultar todas as pecas apenas quando as funcoes mudarem.
     -- Desligar e religar cada linha a 45 FPS causava custo e tremedeira.
     if e.activeFlags~=activeFlags then
      espHideParts(e)
      e.activeFlags=activeFlags
     end
     local height=bottom-top
     local midX=(left+right)*.5
     local visible=true
     if needsVisibility then
      -- Limite por frame + cache impedem que todos os jogadores disparem
      -- raycasts no mesmo frame. As posicoes continuam atualizadas normalmente.
      if remainingRaycastTargets>0 and
        (e.visibilityAt==nil or e.visibilityCharacter~=character or now-e.visibilityAt>=.27) then
       e.visibilityResult=espUnblocked(character,targetRoot)
       e.visibilityAt=now
       e.visibilityCharacter=character
       remainingRaycastTargets=remainingRaycastTargets-1
      end
      visible=e.visibilityResult==true
     end
     local color=settings.espRGB and cyan or (visible and C_AZUL or C_VERMELHO)
     -- Highlight nativo segue o personagem REAL e respeita paredes.
     -- Uma instancia por alvo, criada apenas quando a opcao estiver ligada.
     if settings.espHighlight then
      local hl=e.highlight
      if not hl or not hl.Parent then
       hl=Instance.new('Highlight')
       hl.Name='VELOSO_ESP_Highlight'
       hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
       hl.FillTransparency=.78
       hl.OutlineTransparency=.12
       hl.Adornee=character
       hl.Parent=character
       e.highlight=hl
      end
      hl.FillColor=color
      hl.OutlineColor=color
      hl.Enabled=true
     elseif e.highlight then
      e.highlight.Enabled=false
     end
     -- Box, nome, vida e linha respeitam o alcance configurado.
     -- Esqueleto so evita tracar detalhes ilegíveis se projetado em pouquissimos
     -- pixels, sem depender da distancia configurada nem fazer quadradinhos.
     local detailed=height>=18
     local thickness=math.clamp(height/170,1,2.1)*(settings.espLineThickness/2)
     -- Linhas simples, sem halo ou camada extra de brilho.
     if settings.espBox then
      -- Box so com quatro linhas finas; sem preenchimento preto.
      e.boxBackground.Visible=false
      local corners={
       {Vector2.new(left,top),Vector2.new(right,top)},
       {Vector2.new(right,top),Vector2.new(right,bottom)},
       {Vector2.new(right,bottom),Vector2.new(left,bottom)},
       {Vector2.new(left,bottom),Vector2.new(left,top)}
      }
      for i=1,4 do
       if not e.box[i] then e.box[i]=espTriple(e.frame) end
       espDrawTriple(e.box[i],corners[i][1],corners[i][2],settings.espLineThickness,C_BRANCO)
      end
     end
     -- Toda linha parte do ponto central escolhido e termina no alvo.
     -- Ocultar fora do alcance configurado e feito antes de desenhar.
     if settings.espLine then
      if not e.tracer then e.tracer=espTriple(e.frame) end
      espDrawTriple(e.tracer,source,Vector2.new(midX,top+height*.35),math.max(1,settings.espLineThickness*.68),color)
     end
     if settings.espName then
      e.name.Visible=true
      e.name.Text=plr.DisplayName
      e.name.TextColor3=color
      e.name.TextSize=height<32 and math.max(8,settings.espTextSize-2) or settings.espTextSize
      e.name.Size=UDim2.fromOffset(math.max(70,math.min(185,right-left+40)),18)
      e.name.Position=UDim2.fromOffset(midX-e.name.Size.X.Offset*.5,top-20)
     end
     if settings.espDistance then
      e.range.Visible=true
      e.range.Text=tostring(math.floor(distanceMeters+.5))..'m'
      e.range.TextColor3=color
      e.range.Position=UDim2.fromOffset(midX-45,bottom+2)
      e.range.Size=UDim2.fromOffset(90,16)
     end
     if settings.espLife then
      -- Barra de vida: tamanho real proporcional a Health/MaxHealth.
      local hp=math.clamp(humanoid.Health/math.max(humanoid.MaxHealth,1),0,1)
      -- Vida SEMPRE colada na borda esquerda da MESMA box, de perto
      -- ou de longe. Nenhum deslocamento fixo de 10 pixels.
      local barW=math.clamp(height/42,2,4)
      local barH=math.max(8,height-2)
      local gap=math.clamp(height/100,2,3)
      local bx=left-gap-barW
