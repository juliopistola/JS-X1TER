-- ESP MY compartilha EXATAMENTE os componentes e calculos 2D do ESP Jogador.
-- A unica diferenca e a origem: LocalPlayer, sem tracer/linha.
local ownLastCharacter=nil
local ownHue=0
local function renderOwnESP()
 local plr=LocalPlayer
 local char=plr.Character
 local h=char and char:FindFirstChildOfClass('Humanoid')
 local r=char and char:FindFirstChild('HumanoidRootPart')
 local e=espEntries[plr]
 if not ownESPEnabled() or not char or not h or h.Health<=0 or not r then
  if e then
   espHideParts(e);e.frame.Visible=false
   if e.highlight then e.highlight.Enabled=false end
