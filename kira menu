-- Mede a silhueta a partir da cabeca, tronco e pes do personagem real.
-- Ignora acessorios e tamanho de colisoes alteradas para evitar boxes gigantes.
local function espBounds(character)
 local cam=Camera or workspace.CurrentCamera
 local rp=character:FindFirstChild('HumanoidRootPart')
 if not cam or not rp or not rp:IsA('BasePart') then return nil end
 local head=character:FindFirstChild('Head')
 local torso=character:FindFirstChild('UpperTorso') or character:FindFirstChild('Torso') or rp
 if not torso:IsA('BasePart') then torso=rp end
 local footL=character:FindFirstChild('LeftFoot') or character:FindFirstChild('Left Leg')
 local footR=character:FindFirstChild('RightFoot') or character:FindFirstChild('Right Leg')
 local headSize=head and head:IsA('BasePart') and (settings.espNaturalSizes[head] or head.Size)
 local topY=headSize and head.Position.Y+headSize.Y*.55
  or rp.Position.Y+2.9
 local bottomY=rp.Position.Y-2.9
 for _,foot in pairs({footL,footR}) do
  if foot and foot:IsA('BasePart') then
   bottomY=math.min(bottomY,foot.Position.Y-foot.Size.Y*.48)
  end
 end
 if topY<=bottomY then topY=bottomY+4 end
 local centerX=torso.Position.X
 local centerZ=torso.Position.Z
 -- Largura deriva da altura natural do rig, nao do Size local de uma hitbox.
 local rigScale=math.clamp((topY-bottomY)/5.5,.6,1.8)
 local width=math.clamp(3.4*rigScale,2.5,5.5)
 local right=cam.CFrame.RightVector*(width*.5)
 local topPoint=Vector3.new(centerX,topY,centerZ)
 local bottomPoint=Vector3.new(centerX,bottomY,centerZ)
 local points={topPoint-right,topPoint+right,bottomPoint-right,bottomPoint+right}
 local x1,y1=math.huge,math.huge
 local x2,y2=-math.huge,-math.huge
 for _,pos in ipairs(points) do
  local q=cam:WorldToViewportPoint(pos)
  if q.Z<=.1 then return nil end
  x1=math.min(x1,q.X);y1=math.min(y1,q.Y)
  x2=math.max(x2,q.X);y2=math.max(y2,q.Y)
 end
 local cx,cy=(x1+x2)*.5,(y1+y2)*.5
 local w=math.max(x2-x1,12)
 local h=math.max(y2-y1,20)
 local vp=cam.ViewportSize
 if w>vp.X*1.5 or h>vp.Y*2 then return nil end
 return cx-w*.5,cy-h*.5,cx+w*.5,cy+h*.5
end

-- Tres pontos evitam considerar um alvo escondido quando a cabeca
-- esta coberta mas o tronco esta livre, ou vice-versa.
local sightParams=RaycastParams.new()
sightParams.FilterType=Enum.RaycastFilterType.Exclude
sightParams.IgnoreWater=true
-- O resultado de visibilidade nao muda de forma relevante a cada frame.
-- Distribuir os raycasts ao longo dos frames evita picos que congelam todas
-- as linhas do ESP de uma vez quando ha muitos jogadores.
local MAX_ESP_RAYCAST_TARGETS_PER_FRAME=3
local function espUnblocked(character,rootPart)
 local cam=workspace.CurrentCamera
 if not cam then return false end
 local eye=cam.CFrame.Position
 local excluded={}
 if LocalPlayer.Character then table.insert(excluded,LocalPlayer.Character) end
 sightParams.FilterDescendantsInstances=excluded
 local candidates={character:FindFirstChild('Head'),character:FindFirstChild('UpperTorso') or character:FindFirstChild('Torso'),rootPart}
 for _,part in ipairs(candidates) do
  if part and part:IsA('BasePart') then
   local travel=part.Position-eye
   if travel.Magnitude<.15 then return true end
   local hit=workspace:Raycast(eye,travel,sightParams)
   if (not hit) or hit.Instance:IsDescendantOf(character) then return true end
  end
 end
 return false
end

-- Pontos nos joints reais do R15 para nao criar um desenho torto
-- usando somente o centro de cada braco/perna.
local cachedRigParts=setmetatable({},{__mode='k'})
local cachedRigAttachments=setmetatable({},{__mode='k'})
local function cachedRigPart(c,name)
 local cache=cachedRigParts[c]
 if not cache then cache={};cachedRigParts[c]=cache end
 local part=cache[name]
 if part and part.Parent==c then return part end
 part=c:FindFirstChild(name)
 if part then cache[name]=part else cache[name]=nil end
 return part
end
local function jointWorld(c,partName,attachName,fallbackOffset)
 local part=cachedRigPart(c,partName)
 if not part or not part:IsA('BasePart') then return nil end
 local att=nil
 if attachName then
  local cache=cachedRigAttachments[part]
  if not cache then cache={};cachedRigAttachments[part]=cache end
  att=cache[attachName]
  if not att or att.Parent~=part then
   att=part:FindFirstChild(attachName)
   cache[attachName]=att
  end
 end
 if att and att:IsA('Attachment') then return att.WorldPosition end
 return part.CFrame:PointToWorldSpace(fallbackOffset or Vector3.zero)
end
