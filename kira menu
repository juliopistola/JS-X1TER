local openScale=make('UIScale',{Name='KIRA_PainelEscala',Scale=1},menu)
local function fitScaleForDevice()
 local vp=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720)
 return math.clamp(math.min((vp.X-22)/960,(vp.Y-26)/550),.42,1.15)
